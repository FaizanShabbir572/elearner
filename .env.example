# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used in email links)
APP_URL="http://localhost:3000"

# Where "new registration" alerts go
ADMIN_EMAIL="admin@example.com"

# Seeded admin account (created by `npm run setup`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"

# Email — choose ONE option. If neither is set, emails are printed to the server console.
# Option A: Resend (https://resend.com)
RESEND_API_KEY=""
# Option B: any SMTP server (Gmail app password, Mailgun, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="E-Learning <no-reply@example.com>"

# Timezone used to display login times in the admin area (IANA name)
APP_TIMEZONE="Asia/Karachi"
