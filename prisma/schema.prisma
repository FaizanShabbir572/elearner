// SQLite has no native enums, so role/status/level are stored as strings
// and validated in src/lib/constants.ts. Switch provider to "postgresql"
// for production and these can become real enums.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  password         String
  telegramId       String? // email-format Telegram identifier
  uid              String?
  role             String        @default("STUDENT") // ADMIN | STUDENT
  status           String        @default("PENDING") // PENDING | APPROVED | REJECTED
  proficiencyLevel String? // BEGINNER | INTERMEDIATE | ADVANCED
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  progress         Progress[]
  certificates     Certificate[]
  loginSessions    LoginSession[]
  notes            LessonNote[]
  actions          Action[]
}

model Course {
  id               String        @id @default(cuid())
  title            String
  description      String        @default("")
  proficiencyLevel String        @default("BEGINNER")
  published        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  modules          Module[]
  certificates     Certificate[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id        String     @id @default(cuid())
  moduleId  String
  title     String
  content   String     @default("")
  videoUrl  String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  Progress[]
  notes     LessonNote[]
  actions   Action[]

  @@index([moduleId])
}

model LessonNote {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  timestampSec Int? // video position in seconds; null for lessons without a video
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  actions      Action[]

  @@index([userId, lessonId])
  @@index([userId, updatedAt])
}

// A student's own to-do item ("action"), optionally linked to the lesson/note it came from.
model Action {
  id          String      @id @default(cuid())
  userId      String
  lessonId    String?
  noteId      String?
  title       String
  description String      @default("")
  status      String      @default("TODO") // TODO | IN_PROGRESS | DONE
  dueDate     DateTime? // stored as UTC midnight of the chosen calendar day
  source      String      @default("MANUAL") // MANUAL | AI
  fromNote    Boolean     @default(false) // created from a note; stays true if the note is later deleted
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  note        LessonNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([noteId])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  issuedAt          DateTime @default(now())
  certificateNumber String   @unique
  manual            Boolean  @default(false) // true when issued by an admin rather than on completion
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LoginSession {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  endReason  String? // LOGOUT | TIMEOUT | NEW_LOGIN
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
