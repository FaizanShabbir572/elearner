# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used in email links)
APP_URL="http://localhost:4600"

# Where "new registration" alerts go
ADMIN_EMAIL="admin@example.com"

# Seeded admin account (created by `npm run setup`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"

# Email — choose ONE option. If neither is set, emails are printed to the server console.
# Option A: Resend (https://resend.com)
RESEND_API_KEY=""
# Option B: any SMTP server (Gmail app password, Mailgun, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="E-Learning <no-reply@example.com>"

# Timezone used to display login times in the admin area (IANA name)
APP_TIMEZONE="Asia/Karachi"

# Optional AI features (action suggestions, quizzes). Leave empty to turn AI off —
# everything else keeps working and AI buttons are hidden. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=""
# Model used for AI features (fast and low-cost by default)
AI_MODEL="claude-haiku-5-5"

# Uploaded lesson videos are served only to students with access to the lesson, and are limited to
# VIDEO_MAX_MB per file. With Bunny Storage set, new uploads go there; otherwise they stay on this
# server's disk (default ./uploads/videos, outside public/).
BUNNY_STORAGE_ENDPOINT=""  # e.g. https://storage.bunnycdn.com/your-storage-zone
BUNNY_STORAGE_KEY=""       # the storage zone's password, kept on the server only
VIDEO_UPLOAD_DIR=""
VIDEO_MAX_MB="2048"
