// SQLite has no native enums, so role/status/level are stored as strings
// and validated in src/lib/constants.ts. Switch provider to "postgresql"
// for production and these can become real enums.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  password         String
  telegramId       String? // email-format Telegram identifier
  uid              String?
  role             String        @default("STUDENT") // ADMIN | STUDENT
  status           String        @default("PENDING") // PENDING | APPROVED | REJECTED
  proficiencyLevel String? // BEGINNER | INTERMEDIATE | ADVANCED
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  progress         Progress[]
  certificates     Certificate[]
  loginSessions    LoginSession[]
  notes            LessonNote[]
  actions          Action[]
  aiUsage          AiUsage[]
  quizAttempts     QuizAttempt[]
  challenges       ChallengeResponse[]
  lessonViews      LessonView[]
  examAssignments  ExamAssignment[]
  notifications    Notification[]
}

model Course {
  id               String        @id @default(cuid())
  title            String
  description      String        @default("")
  proficiencyLevel String        @default("BEGINNER")
  published        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  modules          Module[]
  certificates     Certificate[]
  notifications    Notification[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id        String     @id @default(cuid())
  moduleId  String
  title     String
  content   String     @default("")
  videoUrl  String?
  transcript String    @default("") // optional video transcript / key points; improves quizzes
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  Progress[]
  notes     LessonNote[]
  actions   Action[]
  assessment   LessonAssessment?
  quizAttempts QuizAttempt[]
  challenges   ChallengeResponse[]
  views        LessonView[]

  @@index([moduleId])
}

model LessonNote {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  timestampSec Int? // video position in seconds; null for lessons without a video
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  actions      Action[]

  @@index([userId, lessonId])
  @@index([userId, updatedAt])
}

// A student's own to-do item ("action"), optionally linked to the lesson/note it came from.
model Action {
  id          String      @id @default(cuid())
  userId      String
  lessonId    String?
  noteId      String?
  title       String
  description String      @default("")
  status      String      @default("TODO") // TODO | IN_PROGRESS | DONE
  dueDate     DateTime? // stored as UTC midnight of the chosen calendar day
  source      String      @default("MANUAL") // MANUAL | AI
  fromNote    Boolean     @default(false) // created from a note; stays true if the note is later deleted
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  note        LessonNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([noteId])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  issuedAt          DateTime @default(now())
  certificateNumber String   @unique
  manual            Boolean  @default(false) // true when issued by an admin rather than on completion
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LoginSession {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  endReason  String? // LOGOUT | TIMEOUT | NEW_LOGIN
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// One row per AI request, used for per-user daily limits (cost control).
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  kind      String // e.g. SUGGEST_ACTIONS
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// AI-generated quiz + practice challenges, cached once per lesson (shared by all students).
model LessonAssessment {
  id             String   @id @default(cuid())
  lessonId       String   @unique
  questionsJson  String // [{ id, question, options[4], correctIndex, explanation, sourceQuote }]
  challengesJson String // [{ id, title, instructions, checklist[] }]
  sourceHash     String // hash of the lesson text it was generated from; a change triggers regeneration
  source         String   @default("AI")
  generatedAt    DateTime @default(now())
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  score       Int
  total       Int
  answersJson String // { [questionId]: { choice, correct } }
  isRetry     Boolean  @default(false)
  kind        String   @default("QUIZ") // QUIZ (lesson quiz) | RECALL (quick-recall round)
  percent     Int      @default(0) // round(score / total * 100), for aggregate queries
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([userId, createdAt])
}

model ChallengeResponse {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  challengeId   String
  answer        String    @default("")
  reflection    String    @default("")
  checklistJson String    @default("[]") // boolean per checklist item
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, challengeId])
  @@index([userId, completedAt])
}

// How far a student has watched a lesson video, and when they last revisited it.
model LessonView {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  maxPositionSec Int       @default(0)
  durationSec    Int?
  watched        Boolean   @default(false) // reached at least 80% of the video
  firstWatchedAt DateTime  @default(now())
  lastWatchedAt  DateTime  @default(now())
  lastReviewedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, lastWatchedAt])
}

// A message from an admin to one student, shown in the app and optionally emailed.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  courseId    String?
  title       String
  message     String
  emailStatus String? // SENT | FAILED | NOT_CONFIGURED; null when no email was requested
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Admin-authored quizzes ("Quizzes" in the UI): written by an admin, assigned to students,
// and marked pass/fail by an admin. Separate from the auto-generated lesson quizzes above.
model Exam {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  passMark    Int              @default(60) // % used to suggest pass/fail; the admin decides
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  questions   ExamQuestion[]
  assignments ExamAssignment[]
}

model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  text         String
  options      String // JSON array of exactly 4 strings
  correctIndex Int // 0-3
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, order])
}

model ExamAssignment {
  id          String    @id @default(cuid())
  examId      String
  userId      String
  status      String    @default("ASSIGNED") // ASSIGNED | SUBMITTED | PASSED | FAILED
  dueDate     DateTime? // UTC midnight of the chosen day
  answersJson String    @default("{}") // { [questionId]: optionIndex }; autosaved while ASSIGNED
  score       Int? // correct answers, computed on submit
  total       Int?
  reviewNote  String    @default("")
  assignedAt  DateTime  @default(now())
  submittedAt DateTime?
  reviewedAt  DateTime?
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([userId, status])
  @@index([examId, status])
}
